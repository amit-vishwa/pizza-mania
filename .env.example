# Application environment
ENVIRONMENT=local

# MySQL
DB_HOSTNAME=jdbc:mysql://localhost:3306/pizza_mania
DB_USERNAME=pizza_mania
DB_PASSWORD=replace-with-a-local-database-password

# JWT (Base64-encoded key of sufficient length for the selected HMAC algorithm)
JWT_SECRET=replace-with-a-base64-encoded-secret
JWT_EXP_MS=3600000

# AWS Cognito
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=replace-with-a-user-pool-id
EXTERNAL_USER_TYPE=external
OAUTH2_ISSUER_URI=https://cognito-idp.ap-south-1.amazonaws.com/replace-with-a-user-pool-id

# Optional local demo users: user@example.com, manager@example.com, admin@example.com
# Keep disabled unless explicitly needed. The shared password must be at least 12 characters.
BOOTSTRAP_USERS_ENABLED=false
BOOTSTRAP_USERS_PASSWORD=replace-with-a-strong-local-only-password
